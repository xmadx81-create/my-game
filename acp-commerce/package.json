{
  "name": "acp-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Virtuals ACP provider agent: data cleaning / transform / validation services with admin dashboard",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "simulate": "node src/bin/simulate.js",
    "simulate:dashboard": "node src/bin/simulate.js --repeat 3 --dashboard 8787",
    "dashboard": "node src/bin/dashboard.js 8787",
    "provider:testnet": "IS_TESTNET=true node src/bin/provider.js --dashboard 8787",
    "admin": "node src/bin/admin.js",
    "acp": "acp"
  },
  "dependencies": {
    "@virtuals-protocol/acp-cli": "1.0.40"
  }
}
